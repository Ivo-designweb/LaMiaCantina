{
  "version": 2,
  "builds": [
    { "src": "api/consigli.js",        "use": "@vercel/node" },
    { "src": "api/claude-consigli.js", "use": "@vercel/node" },
    { "src": "api/gemini-consigli.js", "use": "@vercel/node" },
    { "src": "api/email-reminder.js",  "use": "@vercel/node" },
    { "src": "api/cron-reminder.js",   "use": "@vercel/node" },
    { "src": "*.html",                 "use": "@vercel/static" },
    { "src": "*.webp",                 "use": "@vercel/static" },
    { "src": "*.png",                  "use": "@vercel/static" },
    { "src": "*.js",                   "use": "@vercel/static" },
    { "src": "manifest.json",          "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/consigli",        "dest": "/api/consigli.js" },
    { "src": "/api/claude-consigli", "dest": "/api/claude-consigli.js" },
    { "src": "/api/gemini-consigli", "dest": "/api/gemini-consigli.js" },
    { "src": "/api/email-reminder",  "dest": "/api/email-reminder.js" },
    { "src": "/api/cron-reminder",   "dest": "/api/cron-reminder.js" },
    { "src": "/(.*)",                "dest": "/$1" }
  ],
  "crons": [
    {
      "path":     "/api/cron-reminder",
      "schedule": "0 8 * * *"
    }
  ]
}
"web-push": "^3.6.7"
